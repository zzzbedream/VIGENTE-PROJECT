{
  "name": "vigente-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo VIGENTE - PymeToken v2.0 (Soroban) + Frontend Next.js",
  "workspaces": ["web"],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",

    "build:contract": "cd contracts/margin-controller && cargo build --release --target wasm32-unknown-unknown",
    "test:contract": "cd contracts/margin-controller && cargo test",
    "test:badge": "cd contracts/vigente-badge && cargo test",
    "optimize:contract": "cd contracts/margin-controller && stellar contract optimize --wasm target/wasm32-unknown-unknown/release/margin_controller.wasm",
    "deploy:contract": "cd contracts/margin-controller && stellar contract deploy --network testnet --source admin-v2 --wasm target/wasm32-unknown-unknown/release/margin_controller.optimized.wasm",

    "smoke-test": "npx tsx web/smoke-test.ts",
    "setup": "cd web && npm install"
  },
  "dependencies": {
    "next": "16.1.0"
  },
  "keywords": ["soroban", "stellar", "blockchain", "nextjs", "monorepo", "pyme"],
  "license": "MIT"
}
