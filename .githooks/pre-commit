#!/usr/bin/env bash
# =============================================================================
# Vigente Protocol — pre-commit: bloquea secretos antes de que entren a git
# =============================================================================
# Activación (una vez por clon):
#     git config core.hooksPath .githooks
#
# Origen: incidente C-01 (2026-07-18) — la ADMIN_SECRET del margin-controller
# estuvo hardcodeada en 7 archivos versionados. Este hook impide la reincidencia.
# =============================================================================
set -uo pipefail

# Patrones de secreto. El primero es el que causó el incidente.
PATTERNS=(
  'S[A-Z2-7]{55}'                    # llave secreta Stellar (seed)
  '-----BEGIN[A-Z ]*PRIVATE KEY'     # clave privada PEM
  'AKIA[0-9A-Z]{16}'                 # AWS access key id
  'sk-[A-Za-z0-9]{20,}'              # token estilo OpenAI
  'VIGENTE_ORACLE_SEEDS_HEX=.'       # semillas del oráculo k-de-n (con valor)
  'SERVICE_ROLE_KEY=.'               # service role de Supabase (con valor)
)

# Solo archivos staged, de texto, que se añaden o modifican.
# Una SOLA pasada sobre todo el diff staged. Recorrer archivo por archivo y
# patrón por patrón hacía N×M invocaciones de git y volvía el hook inusable en
# commits grandes (un archivado de ~130 archivos lo colgaba durante minutos).
#
# Se excluyen binarios, dependencias y los dos ficheros que contienen los
# patrones como texto literal (si no, se bloquean a sí mismos).
DIFF=$(git diff --cached -U0 --diff-filter=ACM \
  -- . \
  ':(exclude)*.wasm' ':(exclude)*.png' ':(exclude)*.jpg' ':(exclude)*.jpeg' \
  ':(exclude)*.gif' ':(exclude)*.pdf' ':(exclude)*.ico' ':(exclude)*.lock' \
  ':(exclude)node_modules' ':(exclude)*/node_modules' \
  ':(exclude).githooks/pre-commit' ':(exclude).github/workflows/secret-scan.yml' \
  2>/dev/null)
[ -z "$DIFF" ] && exit 0

# Solo líneas AÑADIDAS (descartando la cabecera '+++' del diff).
ADDED=$(printf '%s\n' "$DIFF" | grep -E '^\+' | grep -v '^+++')
[ -z "$ADDED" ] && exit 0

FOUND=0
for p in "${PATTERNS[@]}"; do
  # `-e` es obligatorio: hay patrones que empiezan con '-' (claves PEM)
  # y grep los interpretaría como opciones.
  if printf '%s\n' "$ADDED" | grep -qE -e "$p"; then
    echo "❌ SECRETO DETECTADO — patrón: $p"
    # Localiza el archivo culpable sin volcar el valor.
    printf '%s\n' "$DIFF" | awk -v pat="$p" '
      /^\+\+\+ b\// { file = substr($0, 7) }
      /^\+/ && $0 !~ /^\+\+\+/ { if ($0 ~ pat) print "   en: " file }
    ' | sort -u
    FOUND=1
  fi
done

if [ "$FOUND" -ne 0 ]; then
  cat <<'EOF'

═══════════════════════════════════════════════════════════════
 COMMIT BLOQUEADO — se detectó un posible secreto.
═══════════════════════════════════════════════════════════════
 Los secretos NUNCA van al repositorio. Opciones correctas:
   • Léelo del entorno:  process.env.ADMIN_SECRET
   • Guárdalo en un .env (ya ignorado por git)
   • En documentación usa un placeholder: <TU_ADMIN_SECRET>

 Si es un FALSO POSITIVO (p. ej. una clave pública G…, que este
 hook no bloquea, o datos de prueba), salta el hook a conciencia:
     git commit --no-verify
═══════════════════════════════════════════════════════════════
EOF
  exit 1
fi

exit 0
