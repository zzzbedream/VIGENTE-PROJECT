const LANG_STORAGE_KEY = "vigente:lang";

// ---------------------------------------------------------------------------
// Tiny context just for this page so HeroNav / Modules / Footer all share the
// active language and the t() lookup without prop-drilling.
// ---------------------------------------------------------------------------
interface LandingCtx {
  lang: Lang;
  setLang: (l: Lang) => void;
  t: (key: string) => string;
}
const LandingContext = createContext<LandingCtx | null>(null);

function useLanding(): LandingCtx {
  const ctx = useContext(LandingContext);
  if (!ctx) throw new Error("LandingContext missing");
  return ctx;
}

function LandingProvider({ children }: { children: ReactNode }) {
  const [lang, setLangState] = useState<Lang>("en");

  useEffect(() => {
    if (typeof window === "undefined") return;
    const saved = window.localStorage.getItem(LANG_STORAGE_KEY) as Lang | null;
    if (saved && (saved === "en" || saved === "es" || saved === "pt")) {
      setLangState(saved);
    } else {
      const nav = (navigator.language || "en").slice(0, 2).toLowerCase();
      if (nav === "es" || nav === "pt") setLangState(nav as Lang);
    }
  }, []);

  const setLang = useCallback((l: Lang) => {
    setLangState(l);
    if (typeof window !== "undefined") {
      window.localStorage.setItem(LANG_STORAGE_KEY, l);
    }
  }, []);

  const t = useCallback(
    (key: string) => STRINGS[lang][key] ?? STRINGS.en[key] ?? key,
    [lang],
  );

  const value = useMemo(() => ({ lang, setLang, t }), [lang, setLang, t]);

  return (
    <LandingContext.Provider value={value}>{children}</LandingContext.Provider>
  );
}

