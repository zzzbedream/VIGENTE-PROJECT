"use client";

/**
 * Vigente Protocol — Landing page (Phase D refresh)
 *
 * Implements the prompt structure: hero with floating pill navbar, staggered
 * lowercase typography, three stat blocks at the corners; three functional
 * modules below the fold (live score evaluator, threshold sig visualizer,
 * pinned testnet tx evidence).
 *
 * Background: subtle radial gradient + grid (placeholder for the eventual
 * looping mp4). Palette is strictly black / white / navy / green-500 — no
 * cyan-purple from the old landing.
 *
 * The page is wired against existing endpoints:
 *   - GET /api/oracle/score-onchain  (Module 1)
 *   - static known mint hashes       (Module 3)
 */

import Link from "next/link";
