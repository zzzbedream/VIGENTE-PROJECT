        </p>

        <div className="grid md:grid-cols-2 gap-6">
          <TxCard
            title={t("mod3_pos")}
            color="#22c55e"
            txHash="8b9fccfc9daaf594e457e19808ef9c0746e8e45f37aab8417b5fe8d59641bc85"
            fields={[
              ["score", "880"],
              ["age days", "90"],
              ["status", "SUCCESS"],
              ["sigs", "3 of 5"],
              ["get_score returned", "880"],
            ]}
          />
          <TxCard
            title={t("mod3_neg")}
