      <div className="relative h-full w-full">
        {words.map((word, idx) => (
          <h1
            key={`${lang}-${idx}-${word}`}
            className={`hero-title absolute text-white font-medium text-[14vw] md:text-[13vw] ${HERO_POSITIONS[idx]}`}
