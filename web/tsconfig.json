{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Scaffold for the CTO: not wired into runtime and imported by nothing
    // (see src/db/schema.ts header). Its dependencies -- drizzle-orm, postgres,
    // drizzle-kit -- are deliberately not installed, so type-checking it breaks
    // the production build. Add the deps and remove this exclusion when the
    // score cache actually moves to Postgres.
    "src/db/**",
    "drizzle.config.ts"
  ]
}
