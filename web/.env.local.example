# Stellar Network Configuration
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_CONTRACT_ID=your_contract_id_here

# Backend Admin (for API routes only)
RPC_URL=https://soroban-testnet.stellar.org
ADMIN_SECRET=your_admin_secret_key
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Margin controller wiring — all optional. scripts/validate-t1.ts defaults to
# the live instance on our own pool; override only to validate a different
# deployment (e.g. v1 CA4SFW73… on Blend's canonical pool CCEBVDYM…).
# Leaving these unset is the normal case.
# NEXT_PUBLIC_MARGIN_CONTROLLER_ID=CCZNOV65...
# NEXT_PUBLIC_BLEND_POOL_ID=CDYUHA3T...
# NEXT_PUBLIC_PRICE_ORACLE_ID=CCG6EAGO...
# NEXT_PUBLIC_MARGIN_DEMO_USER=GC6IPCM3...

# Mother account (Day 1 Track T3 — funds synthetic profiles in Day 5)
# Generated automatically by: npm run setup:mother
# NEVER commit real values. The script appends them to .env.local locally.
VIGENTE_MOTHER_PUBKEY=G...
VIGENTE_MOTHER_SECRET=S...

# Oracle HMAC signing key (Phase G.1 — legacy /api/oracle/score)
# Required. Without this the route panics at module load (startup guard).
# Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In Vercel: set as Sensitive Env Var. NEVER share with ADMIN_SECRET — separate blast radius.
ORACLE_HMAC_SECRET=64_char_hex_string_here

# API guard — webhook secret for server-to-server calls (Phase G.2)
# Browser flow uses the same-origin bypass; non-browser callers (deploy
# scripts, smoke tests, other services) MUST send the header
#   x-webhook-secret: <this value>
# Without it they get 401 Unauthorized.
# Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In Vercel: set as Sensitive Env Var. Rotate independently of ORACLE_HMAC_SECRET.
VIGENTE_WEBHOOK_SECRET=64_char_hex_string_here

# Canonical site URL used by api-guard.ts to validate Origin/Referer.
# In production set to the Vercel URL (no trailing slash).
# localhost:* is always allowed; this is the production allowlist.
NEXT_PUBLIC_SITE_URL=https://vigente-hackathon-final.vercel.app

# Supabase (Postgres) — CTO connects this. Used by the Drizzle scaffold in
# src/db/. NOT required for build or for the current runtime (the score cache
# is still in-memory until the CTO swaps it). Use the Supabase connection
# pooler URL (Transaction mode, port 6543) for serverless:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# See src/db/README.md for setup + migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Etherfuse fiat ramp — SANDBOX only (https://api.sand.etherfuse.com).
# Sent as `Authorization: <key>` with NO `Bearer` prefix.
# Only needed to run the ramp exploration scripts; nothing in the app
# requires it. Asset identifiers differ between sandbox and production —
# always read them from GET /ramp/assets, never hardcode.
ETHERFUSE_API_KEY=your_sandbox_api_key
